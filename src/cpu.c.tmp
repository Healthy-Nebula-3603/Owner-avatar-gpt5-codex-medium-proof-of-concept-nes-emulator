#include "cpu.h"

#include <limits.h>
#include <string.h>

#include "bus.h"
#include "nes_internal.h"
#include "util.h"

enum {
    FLAG_C = 1 << 0,
    FLAG_Z = 1 << 1,
    FLAG_I = 1 << 2,
    FLAG_D = 1 << 3,
    FLAG_B = 1 << 4,
    FLAG_U = 1 << 5,
    FLAG_V = 1 << 6,
    FLAG_N = 1 << 7,
};

typedef enum {
    ADDR_IMP,
    ADDR_ACC,
    ADDR_IMM,
    ADDR_ZP,
    ADDR_ZPX,
    ADDR_ZPY,
    ADDR_REL,
    ADDR_ABS,
    ADDR_ABX,
    ADDR_ABY,
    ADDR_IND,
    ADDR_INX,
    ADDR_INY
} AddressMode;

static inline uint8_t cpu_read(CPU6502 *cpu, uint16_t addr) {
    return nes_cpu_read(cpu->nes, addr);
}

static inline void cpu_write(CPU6502 *cpu, uint16_t addr, uint8_t value) {
    nes_cpu_write(cpu->nes, addr, value);
}

static inline void set_flag(CPU6502 *cpu, uint8_t mask, bool value) {
    if (value) {
        cpu->status |= mask;
    } else {
        cpu->status &= (uint8_t)~mask;
    }
}

static inline bool get_flag(const CPU6502 *cpu, uint8_t mask) {
    return (cpu->status & mask) != 0;
}

static inline void update_zn(CPU6502 *cpu, uint8_t value) {
    set_flag(cpu, FLAG_Z, value == 0);
    set_flag(cpu, FLAG_N, (value & 0x80) != 0);
}

static inline uint8_t pull_byte(CPU6502 *cpu) {
    cpu->sp = (uint8_t)(cpu->sp + 1);
    return cpu_read(cpu, (uint16_t)(0x0100 | cpu->sp));
}

static inline void push_byte(CPU6502 *cpu, uint8_t value) {
    cpu_write(cpu, (uint16_t)(0x0100 | cpu->sp), value);
    cpu->sp = (uint8_t)(cpu->sp - 1);
}

static inline uint8_t fetch_byte(CPU6502 *cpu) {
    uint8_t value = cpu_read(cpu, cpu->pc);
    cpu->pc = (uint16_t)(cpu->pc + 1);
    return value;
}

static inline uint16_t fetch_word(CPU6502 *cpu) {
    uint8_t lo = fetch_byte(cpu);
    uint8_t hi = fetch_byte(cpu);
    return (uint16_t)(lo | (hi << 8));
}

static inline uint16_t read_word(CPU6502 *cpu, uint16_t addr) {
    uint8_t lo = cpu_read(cpu, addr);
    uint8_t hi = cpu_read(cpu, (uint16_t)(addr + 1));
    return (uint16_t)(lo | (hi << 8));
}

static uint16_t addr_mode_fetch(CPU6502 *cpu, AddressMode mode, bool *page_crossed) {
    *page_crossed = false;

    switch (mode) {
    case ADDR_IMM:
        return fetch_byte(cpu);
    case ADDR_ZP:
        return fetch_byte(cpu);
    case ADDR_ZPX: {
        uint8_t base = fetch_byte(cpu);
        return (uint8_t)(base + cpu->x);
    }
    case ADDR_ZPY: {
        uint8_t base = fetch_byte(cpu);
        return (uint8_t)(base + cpu->y);
    }
    case ADDR_ABS:
        return fetch_word(cpu);
    case ADDR_ABX: {
        uint16_t base = fetch_word(cpu);
        uint16_t addr = (uint16_t)(base + cpu->x);
        *page_crossed = ((base & 0xFF00) != (addr & 0xFF00));
        return addr;
    }
    case ADDR_ABY: {
        uint16_t base = fetch_word(cpu);
        uint16_t addr = (uint16_t)(base + cpu->y);
        *page_crossed = ((base & 0xFF00) != (addr & 0xFF00));
        return addr;
    }
    case ADDR_IND: {
        uint16_t ptr = fetch_word(cpu);
        uint16_t hi_addr = (uint16_t)((ptr & 0xFF00) | ((ptr + 1) & 0x00FF));
        uint8_t lo = cpu_read(cpu, ptr);
        uint8_t hi = cpu_read(cpu, hi_addr);
        return (uint16_t)(lo | (hi << 8));
    }
    case ADDR_INX: {
        uint8_t zp = fetch_byte(cpu);
        uint8_t ptr = (uint8_t)(zp + cpu->x);
        uint8_t lo = cpu_read(cpu, ptr);
        uint8_t hi = cpu_read(cpu, (uint8_t)(ptr + 1));
        return (uint16_t)(lo | (hi << 8));
    }
    case ADDR_INY: {
        uint8_t zp = fetch_byte(cpu);
        uint8_t lo = cpu_read(cpu, zp);
        uint8_t hi = cpu_read(cpu, (uint8_t)(zp + 1));
        uint16_t base = (uint16_t)(lo | (hi << 8));
        uint16_t addr = (uint16_t)(base + cpu->y);
        *page_crossed = ((base & 0xFF00) != (addr & 0xFF00));
        return addr;
    }
    case ADDR_REL: {
        int8_t offset = (int8_t)fetch_byte(cpu);
        return (uint16_t)(cpu->pc + offset);
    }
    case ADDR_IMP:
    case ADDR_ACC:
    default:
        return 0;
    }
}

static void branch(CPU6502 *cpu, bool condition, uint16_t target, uint8_t *cycles) {
    if (condition) {
        (*cycles)++;
        if ((cpu->pc & 0xFF00) != (target & 0xFF00)) {
            (*cycles)++;
        }
        cpu->pc = target;
    }
}

static inline uint8_t op_asl(CPU6502 *cpu, uint8_t value) {
    set_flag(cpu, FLAG_C, (value & 0x80) != 0);
    value <<= 1;
    update_zn(cpu, value);
    return value;
}

static inline uint8_t op_lsr(CPU6502 *cpu, uint8_t value) {
    set_flag(cpu, FLAG_C, (value & 0x01) != 0);
    value >>= 1;
    update_zn(cpu, value);
    return value;
}

static inline uint8_t op_rol(CPU6502 *cpu, uint8_t value) {
    bool carry = get_flag(cpu, FLAG_C);
    set_flag(cpu, FLAG_C, (value & 0x80) != 0);
    value = (uint8_t)((value << 1) | (carry ? 1 : 0));
    update_zn(cpu, value);
    return value;
}

static inline uint8_t op_ror(CPU6502 *cpu, uint8_t value) {
    bool carry = get_flag(cpu, FLAG_C);
    set_flag(cpu, FLAG_C, (value & 0x01) != 0);
    value = (uint8_t)((value >> 1) | (carry ? 0x80 : 0x00));
    update_zn(cpu, value);
    return value;
}

static inline void op_adc(CPU6502 *cpu, uint8_t value) {
    uint16_t sum = (uint16_t)cpu->a + value + (get_flag(cpu, FLAG_C) ? 1 : 0);
    set_flag(cpu, FLAG_C, sum > 0xFF);
    uint8_t result = (uint8_t)sum;
    set_flag(cpu, FLAG_V, (~(cpu->a ^ value) & (cpu->a ^ result) & 0x80) != 0);
    cpu->a = result;
    update_zn(cpu, cpu->a);
}

static inline void op_sbc(CPU6502 *cpu, uint8_t value) {
    op_adc(cpu, (uint8_t)(value ^ 0xFF));
}

static inline void op_cmp(CPU6502 *cpu, uint8_t reg, uint8_t value) {
    uint16_t tmp = (uint16_t)reg - value;
    set_flag(cpu, FLAG_C, reg >= value);
    update_zn(cpu, (uint8_t)tmp);
}

static void handle_nmi(CPU6502 *cpu) {
    cpu->nmi_pending = false;
    push_byte(cpu, (uint8_t)(cpu->pc >> 8));
    push_byte(cpu, (uint8_t)(cpu->pc & 0xFF));
    push_byte(cpu, (uint8_t)((cpu->status | FLAG_B) & ~FLAG_U));
    set_flag(cpu, FLAG_I, true);
    cpu->pc = read_word(cpu, 0xFFFA);
}

static void handle_irq(CPU6502 *cpu) {
    push_byte(cpu, (uint8_t)(cpu->pc >> 8));
    push_byte(cpu, (uint8_t)(cpu->pc & 0xFF));
    push_byte(cpu, (uint8_t)((cpu->status | FLAG_B) & ~FLAG_U));
    set_flag(cpu, FLAG_I, true);
    cpu->pc = read_word(cpu, 0xFFFE);
}

void cpu_reset(CPU6502 *cpu, bool hard_reset) {
    NES_UNUSED(hard_reset);
    cpu->sp = 0xFD;
    cpu->status = FLAG_U | FLAG_I;
    cpu->a = cpu->x = cpu->y = 0;
    cpu->pc = read_word(cpu, 0xFFFC);
    cpu->cycles = 0;
    cpu->stall_cycles = 0;
    cpu->nmi_pending = false;
    cpu->irq_pending = false;
}

uint8_t cpu_step(CPU6502 *cpu) {
    if (cpu->stall_cycles > 0) {
        cpu->stall_cycles--;
        cpu->cycles++;
        return 1;
    }

    if (cpu->nmi_pending) {
        handle_nmi(cpu);
        cpu->cycles += 7;
        return 7;
    }

    if (cpu->irq_pending && !get_flag(cpu, FLAG_I)) {
        handle_irq(cpu);
        cpu->cycles += 7;
        cpu->irq_pending = false;
        return 7;
    }

    uint8_t opcode = fetch_byte(cpu);
    uint8_t cycles = 0;
    bool page_crossed = false;

    switch (opcode) {
    case 0x00: /* BRK */
        cpu->pc++;
        push_byte(cpu, (uint8_t)(cpu->pc >> 8));
        push_byte(cpu, (uint8_t)(cpu->pc & 0xFF));
        push_byte(cpu, (uint8_t)(cpu->status | FLAG_B));
        set_flag(cpu, FLAG_I, true);
        cpu->pc = read_word(cpu, 0xFFFE);
        cycles = 7;
        break;
    case 0x01: case 0x05: case 0x09: case 0x0D:
    case 0x11: case 0x15: case 0x19: case 0x1D:
    case 0x21: case 0x25: case 0x29: case 0x2D:
    case 0x31: case 0x35: case 0x39: case 0x3D:
    case 0x41: case 0x45: case 0x49: case 0x4D:
    case 0x51: case 0x55: case 0x59: case 0x5D:
    case 0x61: case 0x65: case 0x69: case 0x6D:
    case 0x71: case 0x75: case 0x79: case 0x7D:
    case 0x81: case 0x85: case 0x89: case 0x8D:
    case 0x91: case 0x95: case 0x99: case 0x9D:
    case 0xA1: case 0xA5: case 0xA9: case 0xAD:
    case 0xB1: case 0xB5: case 0xB9: case 0xBD:
    case 0xC1: case 0xC5: case 0xC9: case 0xCD:
    case 0xD1: case 0xD5: case 0xD9: case 0xDD:
    case 0xE1: case 0xE5: case 0xE9: case 0xED:
    case 0xF1: case 0xF5: case 0xF9: case 0xFD: {
        static const AddressMode modes[8] = {
            ADDR_INX, ADDR_ZP, ADDR_IMM, ADDR_ABS,
            ADDR_INY, ADDR_ZPX, ADDR_ABY, ADDR_ABX
        };
        static const uint8_t base_cycles[8] = {6, 3, 2, 4, 5, 4, 4, 4};
        uint8_t group = (opcode >> 5) & 0x07;
        uint8_t mode_index = (opcode >> 2) & 0x07;
        AddressMode mode = modes[mode_index];
        uint16_t addr = 0;
        uint8_t value = 0;
        if (mode == ADDR_IMM) {
            value = (uint8_t)addr_mode_fetch(cpu, ADDR_IMM, &page_crossed);
        } else {
            addr = addr_mode_fetch(cpu, mode, &page_crossed);
            value = cpu_read(cpu, addr);
        }
        cycles = base_cycles[mode_index];
        bool extra_cycle = false;
        switch (group) {
        case 0: /* ORA */
            cpu->a |= value;
            update_zn(cpu, cpu->a);
            extra_cycle = true;
            break;
        case 1: /* AND */
            cpu->a &= value;
            update_zn(cpu, cpu->a);
            extra_cycle = true;
            break;
        case 2: /* EOR */
            cpu->a ^= value;
            update_zn(cpu, cpu->a);
            extra_cycle = true;
            break;
        case 3: /* ADC */
            op_adc(cpu, value);
            extra_cycle = true;
            break;
        case 4: /* STA */
            if (mode == ADDR_IMM) {
                cycles = 2;
            } else {
                cpu_write(cpu, addr, cpu->a);
                cycles = (mode == ADDR_ABX || mode == ADDR_ABY || mode == ADDR_INY) ? base_cycles[mode_index] : base_cycles[mode_index];
            }
            extra_cycle = false;
            break;
        case 5: /* LDA */
            cpu->a = value;
            update_zn(cpu, cpu->a);
            extra_cycle = true;
            break;
        case 6: /* CMP */
            op_cmp(cpu, cpu->a, value);
            extra_cycle = true;
            break;
        case 7: /* SBC */
            op_sbc(cpu, value);
            extra_cycle = true;
            break;
        default:
            break;
        }
        if (page_crossed && extra_cycle &&
            (mode == ADDR_ABX || mode == ADDR_ABY || mode == ADDR_INY)) {
            cycles++;
        }
        break;
    }
    case 0x06: case 0x0A: case 0x0E: case 0x16: case 0x1E:
    case 0x26: case 0x2A: case 0x2E: case 0x36: case 0x3E:
    case 0x46: case 0x4A: case 0x4E: case 0x56: case 0x5E:
    case 0x66: case 0x6A: case 0x6E: case 0x76: case 0x7E:
    case 0x86: case 0x8A: case 0x8E: case 0x96: case 0x9A:
    case 0xA2: case 0xA6: case 0xAA: case 0xAE: case 0xB6: case 0xBA: case 0xBE:
    case 0xC6: case 0xCA: case 0xCE: case 0xD6: case 0xDE:
    case 0xE6: case 0xEA: case 0xEE: case 0xF6: case 0xFE: {
        uint8_t group = (opcode >> 5) & 0x07;
        uint8_t mode_index = (opcode >> 2) & 0x07;
        static const AddressMode modes[8] = {
            ADDR_IMM, ADDR_ZP, ADDR_ACC, ADDR_ABS,
            ADDR_IMM, ADDR_ZPX, ADDR_ABX, ADDR_ABX
        };
        AddressMode mode = modes[mode_index];
        cycles = 2;
        uint16_t addr = 0;
        uint8_t value = 0;
        switch (group) {
        case 0: /* ASL */
            if (mode == ADDR_ACC) {
                cycles = 2;
                cpu->a = op_asl(cpu, cpu->a);
            } else {
                bool dummy = false;
                addr = addr_mode_fetch(cpu, mode == ADDR_IMM ? ADDR_ZP : mode, &dummy);
                if (mode == ADDR_IMM) {
                    value = (uint8_t)addr;
                } else {
                    value = cpu_read(cpu, addr);
                }
                if (mode == ADDR_ZP) { cycles = 5; }
                else if (mode == ADDR_ZPX) { cycles = 6; }
                else if (mode == ADDR_ABS) { cycles = 6; }
                else if (mode == ADDR_ABX) { cycles = 7; }
                value = op_asl(cpu, value);
                cpu_write(cpu, addr, value);
            }
            break;
        case 1: /* ROL */
            if (mode == ADDR_ACC) {
                cycles = 2;
                cpu->a = op_rol(cpu, cpu->a);
            } else {
                bool dummy = false;
                addr = addr_mode_fetch(cpu, mode == ADDR_IMM ? ADDR_ZP : mode, &dummy);
                value = cpu_read(cpu, addr);
                if (mode == ADDR_ZP) cycles = 5;
                else if (mode == ADDR_ZPX) cycles = 6;
                else if (mode == ADDR_ABS) cycles = 6;
                else if (mode == ADDR_ABX) cycles = 7;
                value = op_rol(cpu, value);
                cpu_write(cpu, addr, value);
            }
            break;
        case 2: /* LSR */
            if (mode == ADDR_ACC) {
                cycles = 2;
                cpu->a = op_lsr(cpu, cpu->a);
            } else {
                bool dummy = false;
                addr = addr_mode_fetch(cpu, mode == ADDR_IMM ? ADDR_ZP : mode, &dummy);
                value = cpu_read(cpu, addr);
                if (mode == ADDR_ZP) cycles = 5;
                else if (mode == ADDR_ZPX) cycles = 6;
                else if (mode == ADDR_ABS) cycles = 6;
                else if (mode == ADDR_ABX) cycles = 7;
                value = op_lsr(cpu, value);
                cpu_write(cpu, addr, value);
            }
            break;
        case 3: /* ROR */
            if (mode == ADDR_ACC) {
                cycles = 2;
                cpu->a = op_ror(cpu, cpu->a);
            } else {
                bool dummy = false;
                addr = addr_mode_fetch(cpu, mode == ADDR_IMM ? ADDR_ZP : mode, &dummy);
                value = cpu_read(cpu, addr);
                if (mode == ADDR_ZP) cycles = 5;
                else if (mode == ADDR_ZPX) cycles = 6;
                else if (mode == ADDR_ABS) cycles = 6;
                else if (mode == ADDR_ABX) cycles = 7;
                value = op_ror(cpu, value);
                cpu_write(cpu, addr, value);
            }
            break;
        case 4: /* STX/TXA */
            if (opcode == 0x8A) { /* TXA */
                cpu->a = cpu->x;
                update_zn(cpu, cpu->a);
                cycles = 2;
            } else if (opcode == 0x9A) { /* TXS */
                cpu->sp = cpu->x;
                cycles = 2;
            } else if (opcode == 0xBA) { /* TSX */
                cpu->x = cpu->sp;
                update_zn(cpu, cpu->x);
                cycles = 2;
            } else {
                bool dummy = false;
                AddressMode eff_mode = (opcode == 0x96) ? ADDR_ZPY : (opcode == 0xBE ? ADDR_ABY : mode);
                addr = addr_mode_fetch(cpu, eff_mode, &dummy);
                cpu_write(cpu, addr, cpu->x);
                cycles = (opcode == 0x86) ? 3 : (opcode == 0x96 ? 4 : 4);
            }
            break;
        case 5: /* LDX / TAX */
            if (opcode == 0xAA) { /* TAX */
                cpu->x = cpu->a;
                update_zn(cpu, cpu->x);
                cycles = 2;
            } else if (opcode == 0xA8) { /* TAY */
                cpu->y = cpu->a;
                update_zn(cpu, cpu->y);
                cycles = 2;
            } else if (opcode == 0x98) { /* TYA */
                cpu->a = cpu->y;
                update_zn(cpu, cpu->a);
                cycles = 2;
            } else if (opcode == 0xB8) { /* CLV */
                set_flag(cpu, FLAG_V, false);
                cycles = 2;
            } else {
                bool dummy = false;
                AddressMode eff_mode = (opcode == 0xB6) ? ADDR_ZPY : (opcode == 0xBE ? ADDR_ABY : mode);
                if (eff_mode == ADDR_IMM) {
                    cpu->x = (uint8_t)addr_mode_fetch(cpu, ADDR_IMM, &dummy);
                    cycles = 2;
                } else {
                    addr = addr_mode_fetch(cpu, eff_mode, &dummy);
                    cpu->x = cpu_read(cpu, addr);
                    cycles = (eff_mode == ADDR_ZPY) ? 4 : (eff_mode == ADDR_ZP ? 3 : (eff_mode == ADDR_ABS ? 4 : 4));
                }
                update_zn(cpu, cpu->x);
            }
            break;
        case 6: /* DEC / DEX */
            if (opcode == 0xCA) { /* DEX */
                cpu->x--;
                update_zn(cpu, cpu->x);
                cycles = 2;
            } else if (opcode == 0x88) { /* DEY */
                cpu->y--;
                update_zn(cpu, cpu->y);
                cycles = 2;
            } else {
                bool dummy = false;
                addr = addr_mode_fetch(cpu, mode == ADDR_IMM ? ADDR_ZP : mode, &dummy);
                value = cpu_read(cpu, addr);
                value--;
                cpu_write(cpu, addr, value);
                update_zn(cpu, value);
                if (mode == ADDR_ZP) cycles = 5;
                else if (mode == ADDR_ZPX) cycles = 6;
                else if (mode == ADDR_ABS) cycles = 6;
                else if (mode == ADDR_ABX) cycles = 7;
            }
            break;
        case 7: /* INC / NOP / INX / ??? */
            if (opcode == 0xE8) { /* INX */
                cpu->x++;
                update_zn(cpu, cpu->x);
                cycles = 2;
            } else if (opcode == 0xC8) { /* INY */
                cpu->y++;
                update_zn(cpu, cpu->y);
                cycles = 2;
            } else if (opcode == 0xEA) { /* NOP */
                cycles = 2;
            } else {
                bool dummy = false;
                addr = addr_mode_fetch(cpu, mode == ADDR_IMM ? ADDR_ZP : mode, &dummy);
                value = cpu_read(cpu, addr);
                value++;
                cpu_write(cpu, addr, value);
                update_zn(cpu, value);
                if (mode == ADDR_ZP) cycles = 5;
                else if (mode == ADDR_ZPX) cycles = 6;
                else if (mode == ADDR_ABS) cycles = 6;
                else if (mode == ADDR_ABX) cycles = 7;
            }
            break;
        default:
            cycles = 2;
            break;
        }
        break;
    }
    case 0x10: case 0x30: case 0x50: case 0x70:
    case 0x90: case 0xB0: case 0xD0: case 0xF0: {
        uint8_t condition_index = (opcode >> 4) & 0x07;
        static const uint8_t flags[8] = {
            FLAG_N, FLAG_N, FLAG_V, FLAG_V,
            FLAG_C, FLAG_C, FLAG_Z, FLAG_Z
        };
        static const bool invert[8] = { true, false, true, false, true, false, true, false };
        uint16_t target = addr_mode_fetch(cpu, ADDR_REL, &page_crossed);
        cycles = 2;
        bool flag_set = get_flag(cpu, flags[condition_index]);
        bool cond = invert[condition_index] ? !flag_set : flag_set;
        branch(cpu, cond, target, &cycles);
        break;
    }
    case 0x18: /* CLC */
        set_flag(cpu, FLAG_C, false);
        cycles = 2;
        break;
    case 0x20: { /* JSR */
        uint16_t addr = fetch_word(cpu);
        uint16_t ret = (uint16_t)(cpu->pc - 1);
        push_byte(cpu, (uint8_t)(ret >> 8));
        push_byte(cpu, (uint8_t)(ret & 0xFF));
        cpu->pc = addr;
        cycles = 6;
        break;
    }
    case 0x21: /* already handled in group */
        cycles = 0;
        break;
    case 0x24: case 0x2C: { /* BIT */
        AddressMode mode = (opcode == 0x24) ? ADDR_ZP : ADDR_ABS;
        bool dummy = false;
        uint16_t addr = addr_mode_fetch(cpu, mode, &dummy);
        uint8_t value = cpu_read(cpu, addr);
        uint8_t result = (uint8_t)(cpu->a & value);
        set_flag(cpu, FLAG_Z, (result == 0));
        set_flag(cpu, FLAG_V, (value & 0x40) != 0);
        set_flag(cpu, FLAG_N, (value & 0x80) != 0);
        cycles = (opcode == 0x24) ? 3 : 4;
        break;
    }
    case 0x28: /* PLP */
        cpu->status = (uint8_t)((pull_byte(cpu) & ~FLAG_B) | FLAG_U);
        cycles = 4;
        break;
    case 0x2A: /* ROL A handled above */
        cycles = 0;
        break;
    case 0x2C: /* handled above */
        cycles = 0;
        break;
    case 0x2E: /* handled */
        cycles = 0;
        break;
    case 0x30: /* handled by branch group */
        cycles = 0;
        break;
    case 0x38: /* SEC */
        set_flag(cpu, FLAG_C, true);
        cycles = 2;
        break;
    case 0x3A: /* NOP */
        cycles = 2;
        break;
    case 0x40: /* RTI */
        cpu->status = (uint8_t)((pull_byte(cpu) & ~FLAG_B) | FLAG_U);
        cpu->pc = pull_byte(cpu);
        cpu->pc |= (uint16_t)pull_byte(cpu) << 8;
        cycles = 6;
        break;
    case 0x48: /* PHA */
        push_byte(cpu, cpu->a);
        cycles = 3;
        break;
    case 0x4C: /* JMP abs */
        cpu->pc = fetch_word(cpu);
        cycles = 3;
        break;
    case 0x4D:
        cycles = 0;
        break;
    case 0x4E:
        cycles = 0;
        break;
    case 0x50: /* branch (handled) */
        cycles = 0;
        break;
    case 0x58: /* CLI */
        set_flag(cpu, FLAG_I, false);
        cycles = 2;
        break;
    case 0x5A: /* NOP */
        cycles = 2;
        break;
    case 0x60: /* RTS */
        cpu->pc = pull_byte(cpu);
        cpu->pc |= (uint16_t)pull_byte(cpu) << 8;
        cpu->pc = (uint16_t)(cpu->pc + 1);
        cycles = 6;
        break;
    case 0x68: /* PLA */
        cpu->a = pull_byte(cpu);
        update_zn(cpu, cpu->a);
        cycles = 4;
        break;
    case 0x6C: { /* JMP (ind) */
        uint16_t ptr = fetch_word(cpu);
        uint16_t hi_addr = (uint16_t)((ptr & 0xFF00) | ((ptr + 1) & 0x00FF));
        uint8_t lo = cpu_read(cpu, ptr);
        uint8_t hi = cpu_read(cpu, hi_addr);
        cpu->pc = (uint16_t)(lo | (hi << 8));
        cycles = 5;
        break;
    }
    case 0x6A:
        cycles = 0;
        break;
    case 0x6E:
        cycles = 0;
        break;
    case 0x70:
        cycles = 0;
        break;
    case 0x78: /* SEI */
        set_flag(cpu, FLAG_I, true);
        cycles = 2;
        break;
    case 0x7A: /* NOP */
        cycles = 2;
        break;
    case 0x84: case 0x8C: case 0x94: { /* STY */
        bool dummy = false;
        AddressMode mode = (opcode == 0x84) ? ADDR_ZP : (opcode == 0x94) ? ADDR_ZPX : ADDR_ABS;
        uint16_t addr = addr_mode_fetch(cpu, mode, &dummy);
        cpu_write(cpu, addr, cpu->y);
        cycles = (opcode == 0x8C) ? 4 : (opcode == 0x94 ? 4 : 3);
        break;
    }
    case 0x88:
        cycles = 0;
        break;
    case 0x8A:
        cycles = 0;
        break;
    case 0x8C:
        cycles = 0;
        break;
    case 0x8D:
        cycles = 0;
        break;
    case 0x90:
        cycles = 0;
        break;
    case 0x98:
        cycles = 0;
        break;
    case 0x9A:
        cycles = 0;
        break;
    case 0x9C: /* SHY (illegal) treat as NOP with read */
        addr_mode_fetch(cpu, ADDR_ABS, &page_crossed);
        cycles = 4;
        break;
    case 0xA0: case 0xA4: case 0xAC: case 0xB4: case 0xBC: { /* LDY */
        AddressMode mode = (opcode == 0xA0) ? ADDR_IMM : (opcode == 0xA4) ? ADDR_ZP :
                              (opcode == 0xB4) ? ADDR_ZPX :
                              (opcode == 0xAC) ? ADDR_ABS : ADDR_ABX;
        bool dummy = false;
        uint8_t value = 0;
        if (mode == ADDR_IMM) {
            value = (uint8_t)addr_mode_fetch(cpu, ADDR_IMM, &dummy);
            cycles = 2;
        } else {
            uint16_t addr = addr_mode_fetch(cpu, mode, &dummy);
            value = cpu_read(cpu, addr);
            cycles = (mode == ADDR_ZP) ? 3 : (mode == ADDR_ZPX ? 4 : (mode == ADDR_ABS ? 4 : 4));
            if (mode == ADDR_ABX && ((addr & 0xFF00) != ((addr - cpu->x) & 0xFF00))) {
                cycles++;
            }
        }
        cpu->y = value;
        update_zn(cpu, cpu->y);
        break;
    }
    case 0xA2:
        cycles = 0;
        break;
    case 0xA8:
        cycles = 0;
        break;
    case 0xAA:
        cycles = 0;
        break;
    case 0xAC:
        cycles = 0;
        break;
    case 0xAD:
        cycles = 0;
        break;
    case 0xB0:
        cycles = 0;
        break;
    case 0xB8:
        cycles = 0;
        break;
    case 0xB9:
        cycles = 0;
        break;
    case 0xBA:
        cycles = 0;
        break;
    case 0xC0: case 0xC4: case 0xCC: { /* CPY */
        AddressMode mode = (opcode == 0xC0) ? ADDR_IMM : (opcode == 0xC4) ? ADDR_ZP : ADDR_ABS;
        bool dummy = false;
        uint8_t value = (mode == ADDR_IMM) ? (uint8_t)addr_mode_fetch(cpu, ADDR_IMM, &dummy)
                                           : cpu_read(cpu, addr_mode_fetch(cpu, mode, &dummy));
        op_cmp(cpu, cpu->y, value);
        cycles = (mode == ADDR_IMM) ? 2 : (mode == ADDR_ZP ? 3 : 4);
        break;
    }
    case 0xC8:
        cycles = 0;
        break;
    case 0xC9:
        cycles = 0;
        break;
    case 0xCA:
        cycles = 0;
        break;
    case 0xCE:
        cycles = 0;
        break;
    case 0xD0:
        cycles = 0;
        break;
    case 0xD8: /* CLD */
        set_flag(cpu, FLAG_D, false);
        cycles = 2;
        break;
    case 0xDA: /* NOP */
        cycles = 2;
        break;
    case 0xE0: case 0xE4: case 0xEC: { /* CPX */
        AddressMode mode = (opcode == 0xE0) ? ADDR_IMM : (opcode == 0xE4) ? ADDR_ZP : ADDR_ABS;
        bool dummy = false;
        uint8_t value = (mode == ADDR_IMM) ? (uint8_t)addr_mode_fetch(cpu, ADDR_IMM, &dummy)
                                           : cpu_read(cpu, addr_mode_fetch(cpu, mode, &dummy));
        op_cmp(cpu, cpu->x, value);
        cycles = (mode == ADDR_IMM) ? 2 : (mode == ADDR_ZP ? 3 : 4);
        break;
    }
    case 0xE8:
        cycles = 0;
        break;
    case 0xE9:
        cycles = 0;
        break;
    case 0xEA:
        cycles = 2;
        break;
    case 0xEC:
        cycles = 0;
        break;
    case 0xF0:
        cycles = 0;
        break;
    case 0xF8: /* SED */
        set_flag(cpu, FLAG_D, true);
        cycles = 2;
        break;
    case 0xFA: /* NOP */
        cycles = 2;
        break;
    default: {
        /* Treat unimplemented opcodes as NOP matching byte length heuristics */
        static const AddressMode illegal_modes[8] = {
            ADDR_IMP, ADDR_ZP, ADDR_IMM, ADDR_ABS,
            ADDR_ABS, ADDR_ZPX, ADDR_ABX, ADDR_ABX
        };
        AddressMode mode = illegal_modes[(opcode >> 2) & 0x07];
        if (mode == ADDR_IMM) {
            addr_mode_fetch(cpu, ADDR_IMM, &page_crossed);
            cycles = 2;
        } else {
            addr_mode_fetch(cpu, mode, &page_crossed);
            cycles = 2;
        }
        break;
    }
    }

    cpu->cycles += cycles;
    return cycles;
}

void cpu_trigger_nmi(CPU6502 *cpu) {
    cpu->nmi_pending = true;
}

void cpu_set_irq_line(CPU6502 *cpu, bool asserted) {
    cpu->irq_pending = asserted;
}

